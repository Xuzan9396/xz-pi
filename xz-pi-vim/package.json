{
  "name": "xz-pi-vim",
  "version": "0.2.0",
  "description": "A local Vim-style modal editor package for Pi's terminal prompt",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi-extension",
    "vim",
    "editor"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Xuzan9396/xz-pi.git",
    "directory": "xz-pi-vim"
  },
  "homepage": "https://github.com/Xuzan9396/xz-pi/tree/main/xz-pi-vim",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "files": [
    "index.ts",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx/esm --test 'test/**/*.test.ts'",
    "check": "npm run typecheck && npm test"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": ">=0.84.4"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.84.4",
    "@earendil-works/pi-tui": "0.84.4",
    "@types/node": "^22.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
