{
  "name": "xz-pi-build-ios-apps",
  "version": "0.1.2",
  "description": "Pi-native iOS development workflows with automatic skill routing and XcodeBuildMCP integration.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "pi-package",
    "pi-extension",
    "mcp",
    "ios",
    "swift",
    "swiftui",
    "xcode",
    "app-intents",
    "performance",
    "debugging"
  ],
  "files": [
    "index.ts",
    "skills",
    "assets",
    "README.md",
    "UPSTREAM.md",
    "LICENSE"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx/esm --test test/*.test.mjs test/*.test.ts",
    "check": "npm run typecheck && npm test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Xuzan9396/xz-pi.git",
    "directory": "xz-pi-build-ios-apps"
  },
  "homepage": "https://github.com/Xuzan9396/xz-pi/tree/main/xz-pi-build-ios-apps",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ],
    "skills": [
      "./skills"
    ],
    "image": "./assets/app-icon.png"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.84.4",
    "@types/node": "^22.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
