    "@earendil-works/pi-tui": ">=0.85.1 <2"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.1.0",
    "@earendil-works/pi-coding-agent": "1.1.0",
    "@earendil-works/pi-tui": "1.1.0",
    "@types/node": "^22.0.0",
    "typescript": "^6.0.2",
    "vitest": "^4.1.11"
  }
