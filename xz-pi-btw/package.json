{
  "name": "xz-pi-btw",
  "version": "0.1.1",
  "description": "Parallel Pi sub-sessions with a large, scrollable BTW overlay and native text selection",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi-extension",
    "side-conversation",
    "btw"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Xuzan9396/xz-pi.git",
    "directory": "xz-pi-btw"
  },
  "homepage": "https://github.com/Xuzan9396/xz-pi/tree/main/xz-pi-btw",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "files": [
    "extensions",
    "skills",
    "README.md",
    "UPSTREAM.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest --run",
    "check": "npm run typecheck && npm test"
  },
  "pi": {
