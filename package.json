{
  "name": "xz-pi-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "Monorepo for independently published xz-pi packages",
  "workspaces": [
    "xz-pi-btw",
    "xz-pi-playwright-cli",
    "xz-pi-websearch",
    "xz-pi-vim"
  ],
  "scripts": {
    "changeset": "changeset",
    "check": "npm run check --workspaces --if-present && npm pack --dry-run --workspaces",
    "version-packages": "changeset version",
    "release": "changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.7"
  }
}
