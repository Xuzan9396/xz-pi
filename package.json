{
  "name": "xz-pi-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "Monorepo for independently published xz-pi packages",
  "workspaces": [
    "xz-pi-btw",
    "xz-pi-build-ios-apps",
    "xz-pi-playwright-cli",
    "xz-pi-websearch",
    "xz-pi-vim"
  ],
  "scripts": {
    "changeset": "changeset",
    "tag": "bash ./tag.sh",
    "test:tag": "node --test scripts/tag.test.mjs",
    "check": "npm run test:tag && npm run check --workspaces --if-present && npm pack --dry-run --workspaces",
    "version-packages": "changeset version",
    "apply-initial-versions": "node scripts/initial-versions.mjs",
    "release": "changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.7",
    "enquirer": "^2.4.1",
    "semver": "^7.7.4"
  }
}
